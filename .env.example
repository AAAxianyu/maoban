ENVIRONMENT=development
# make setup generates the local password; production must have its own credential and volume.
POSTGRES_PASSWORD=replace-with-random-value
DATABASE_URL=postgresql+psycopg://miaoban:replace-with-random-value@127.0.0.1:55432/miaoban
PUBLIC_URL=http://localhost:8000
PUSH_PROVIDER=disabled
# Production-only configuration, supplied securely on the target host:
# DOMAIN=
# ACME_EMAIL=
# SECRETS_DIR=/srv/miaoban/secrets
# APNS_KEY_PATH=/run/secrets/apns.p8
# APNS_KEY_ID=
# APNS_TEAM_ID=
# APNS_TOPIC=
# APNS_SANDBOX=false
# FCM_CREDENTIALS_PATH=/run/secrets/fcm.json
